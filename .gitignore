.htaccess
php53.cgi
include/ost-config.php
*.sw[a-z]
.DS_Store
.vagrant
Vagrantfile

# Staging directory used for packaging script
stage

# Ignore compiled phar files
*.phar

# Ignore hydrated libs & include dir
**/lib
**/include
# ost-workflow keeps its own source under lib/ (PSR-0), not hydrated deps
!/ost-workflow/lib/

# Ignore installed dependencies and composer if placed here
lib/*
!/lib/pear-pear.php.net/
composer.phar
composer.lock
composer.json

# build artifacts of prod-sandbox
prod-sandbox/dist/

# local credentials of the e2e fixtures must never be committed
prod-sandbox/*.env
prod-sandbox/e2e-fixtures/
